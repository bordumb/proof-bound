programme "typescript-codec" ecosystem "typescript"

defaults "node-common"
claims = ["TS-CODEC-001"]
tier = 0
assumptions = ["TS-RUNTIME-001"]
outputs = []
environment_allowlist = ["PATH"]
resource_budget = {"time_seconds":300,"disk_bytes":1073741824,"memory_bytes":2147483648}
end

claim "TS-CODEC-001"
title = "Canonical base64url codec behavior"
statement = "The registered decoder rejects padded input, and bounded generated byte arrays round trip through the encoder and decoder."
public_language = "Registered vitest examples and a bounded fast-check property pass under the strict TypeScript configuration."
subject = "npm:proofbound-typescript-codec::decodeBase64Url"
profile = "ledger"
tier = 0
primary_linkage = "model-only"
evidence = ["example-test:reject-padding","mutation-witness:reject-padding-mutant","property-test:bounded-roundtrip","static-check:strict-types"]
assumptions = ["TS-RUNTIME-001"]
premises = []
open_obligations = []
out_of_scope = ["The bounded property examples are not an unbounded theorem.","TypeScript permits escape hatches that the strict compiler configuration does not make sound.","No source-refinement or artifact-soundness evidence binds runtime behavior to a shipping JavaScript artifact."]
source_roots = ["src/base64url.ts"]
end

evidence node-example "reject-padding" using "node-common"
expected_inventory = ["src/reject-padding.test.ts::base64url codec > rejects padding"]
inputs = ["package-lock.json","package.json","src/base64url.ts","src/reject-padding.test.ts"]
operation = {"type":"vitest"}
end

evidence node-property "bounded-roundtrip" using "node-common"
expected_inventory = ["src/roundtrip.test.ts::base64url codec > round trips bounded byte arrays"]
inputs = ["package-lock.json","package.json","src/base64url.ts","src/roundtrip.test.ts"]
operation = {"type":"vitest"}
end

end
