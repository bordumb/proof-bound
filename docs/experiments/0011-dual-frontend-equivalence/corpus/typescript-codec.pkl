amends "Schema.pkl"

local function common(unit: Evidence, testFile: String): Evidence = (unit) {
  claims = new { "TS-CODEC-001" }
  tier = 0
  assumptions = new { "TS-RUNTIME-001" }
  inputs = new {
    "package-lock.json"
    "package.json"
    "src/base64url.ts"
    testFile
  }
  outputs = new {}
  environment_allowlist = new { "PATH" }
  resource_budget = new ResourceBudget {
    time_seconds = 300
    disk_bytes = 1073741824
    memory_bytes = 2147483648
  }
}

project = new Project {
  id = "typescript-codec"
  ecosystem = "typescript"
}

claims = new Listing {
  new Claim {
    id = "TS-CODEC-001"
    title = "Canonical base64url codec behavior"
    statement = "The registered decoder rejects padded input, and bounded generated byte arrays round trip through the encoder and decoder."
    public_language = "Registered vitest examples and a bounded fast-check property pass under the strict TypeScript configuration."
    subject = "npm:proofbound-typescript-codec::decodeBase64Url"
    profile = "ledger"
    tier = 0
    primary_linkage = "model-only"
    evidence = new {
      "example-test:reject-padding"
      "mutation-witness:reject-padding-mutant"
      "property-test:bounded-roundtrip"
      "static-check:strict-types"
    }
    assumptions = new { "TS-RUNTIME-001" }
    premises = new {}
    open_obligations = new {}
    out_of_scope = new {
      "The bounded property examples are not an unbounded theorem."
      "TypeScript permits escape hatches that the strict compiler configuration does not make sound."
      "No source-refinement or artifact-soundness evidence binds runtime behavior to a shipping JavaScript artifact."
    }
    source_roots = new { "src/base64url.ts" }
  }
}

evidence = new Listing {
  common(new NodeExample {
    id = "reject-padding"
    expected_inventory = new {
      "src/reject-padding.test.ts::base64url codec > rejects padding"
    }
    operation = new VitestOperation {}
  }, "src/reject-padding.test.ts")
  common(new NodeProperty {
    id = "bounded-roundtrip"
    expected_inventory = new {
      "src/roundtrip.test.ts::base64url codec > round trips bounded byte arrays"
    }
    operation = new VitestOperation {}
  }, "src/roundtrip.test.ts")
}
