{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbound.dev/schemas/tcb.schema.json",
  "title": "Proofbound TCB ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "components"],
  "properties": {
    "schema": { "const": "proofbound-tcb-ledger/1" },
    "components": {
      "type": "array", "maxItems": 100000, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "identity_sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 512 },
          "version": { "type": "string", "minLength": 1, "maxLength": 512 },
          "identity_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
