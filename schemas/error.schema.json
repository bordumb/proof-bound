{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbound.dev/schemas/error.schema.json",
  "title": "Proofbound structured error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "code",
    "message",
    "claim_id",
    "unit_id",
    "file",
    "logical_path",
    "byte_offset",
    "expected_identity",
    "actual_identity",
    "affected_claims",
    "remediation"
  ],
  "properties": {
    "schema": { "const": "proofbound-error/1" },
    "code": { "type": "string", "pattern": "^PB-[A-Z0-9-]+-[0-9]{4}$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "claim_id": { "type": ["string", "null"], "maxLength": 160 },
    "unit_id": { "type": ["string", "null"], "maxLength": 128 },
    "file": { "type": ["string", "null"], "maxLength": 4096 },
    "logical_path": { "type": ["string", "null"], "maxLength": 4096 },
    "byte_offset": { "type": ["integer", "null"], "minimum": 0 },
    "expected_identity": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actual_identity": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "affected_claims": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "maxLength": 160 }
    },
    "remediation": { "type": "string", "minLength": 1, "maxLength": 65536 }
  }
}
