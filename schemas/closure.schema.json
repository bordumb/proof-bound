{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbound.dev/schemas/closure.schema.json",
  "title": "Proofbound source or toolchain closure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "kind", "root", "members", "total_bytes", "discovery"],
  "properties": {
    "schema": { "const": "proofbound-closure/1" },
    "id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "kind": { "enum": ["semantic", "runner", "presentation", "external-evidence", "toolchain"] },
    "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "claim_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
    "members": {
      "type": "array", "minItems": 1, "maxItems": 1000000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "discovery": {
      "enum": [
        "assumption-review-claim-union/1",
        "build-tool-transitive/1",
        "evidence-unit-inputs/1",
        "external-evidence/1",
        "project-presentation/1",
        "project-runner/1",
        "toolchains/1",
        "unit-claim-union/1"
      ]
    },
    "tool_identity": { "type": "string", "maxLength": 4096 }
  }
}
