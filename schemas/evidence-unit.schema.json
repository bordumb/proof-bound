{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbound.dev/schemas/evidence-unit.schema.json",
  "title": "Proofbound evidence unit configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "adapter", "kind", "claims", "tier", "operation", "resource_budget"],
  "properties": {
    "schema": { "enum": ["proofbound-evidence-unit/1", "proofbound-evidence-unit/2"] },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "adapter": { "enum": ["lean", "charon-aeneas", "kani", "rust-test", "python-test", "canonical-artifact", "independent-check", "trusted-transcription"] },
    "kind": { "$ref": "evidence.schema.json#/$defs/kind" },
    "claims": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" }, "uniqueItems": true, "minItems": 1, "maxItems": 4096 },
    "tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "operation": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": {
      "type": { "enum": ["cargo-test", "pytest", "generator", "lean-audit", "kani", "translation", "artifact-check", "independent-check", "transcription"] },
      "package": { "type": "string", "minLength": 1, "maxLength": 256 },
      "targets": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 }, "uniqueItems": true, "maxItems": 4096 },
      "paths": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 4096 }, "uniqueItems": true, "maxItems": 4096 },
      "manifest": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "inventory": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "checker": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "arguments": { "type": "array", "items": { "type": "string", "maxLength": 4096 }, "maxItems": 4096 }
    } },
    "evaluation_mode": { "enum": ["kernel", "native"] },
    "binding_mode": { "enum": ["bytes-in-theorem", "digest-theorem", "external-round-trip"] },
    "theorem": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "refinement_theorem": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "premises": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" }, "uniqueItems": true, "maxItems": 4096 },
    "assumptions": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" }, "uniqueItems": true, "maxItems": 4096 },
    "expected_inventory": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "allOf": [
          { "pattern": "\\S" },
          { "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$" }
        ]
      },
      "uniqueItems": true,
      "maxItems": 100000
    },
    "inputs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 4096 }, "uniqueItems": true, "maxItems": 100000 },
    "outputs": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 4096 }, "uniqueItems": true, "maxItems": 100000 },
    "environment_allowlist": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }, "uniqueItems": true, "maxItems": 256 },
    "bounded_domain": { "$ref": "claim.schema.json#/$defs/boundedDomain" },
    "transcription": { "$ref": "#/$defs/trustedTranscription" },
    "resource_budget": { "type": "object", "additionalProperties": false, "required": ["time_seconds", "disk_bytes", "memory_bytes"], "properties": { "time_seconds": { "type": "integer", "minimum": 1 }, "disk_bytes": { "type": "integer", "minimum": 1 }, "memory_bytes": { "type": "integer", "minimum": 1 } } }
  },
  "allOf": [
    {
      "if": { "properties": { "schema": { "const": "proofbound-evidence-unit/1" } }, "required": ["schema"] },
      "then": {
        "allOf": [
          {
            "not": {
              "anyOf": [
                { "required": ["transcription"] },
                { "properties": { "adapter": { "const": "trusted-transcription" } }, "required": ["adapter"] },
                { "properties": { "kind": { "const": "trusted-transcription" } }, "required": ["kind"] },
                { "properties": { "operation": { "properties": { "type": { "const": "transcription" } }, "required": ["type"] } }, "required": ["operation"] }
              ]
            }
          },
          {
            "oneOf": [
              {
                "properties": {
                  "adapter": { "const": "lean" },
                  "kind": { "const": "theorem" },
                  "operation": { "properties": { "type": { "const": "lean-audit" } }, "required": ["type"] }
                },
                "required": ["adapter", "kind", "operation"]
              },
              {
                "properties": {
                  "adapter": { "const": "charon-aeneas" },
                  "kind": { "const": "source-refinement" },
                  "operation": { "properties": { "type": { "const": "translation" } }, "required": ["type"] }
                },
                "required": ["adapter", "kind", "operation"]
              },
              {
                "properties": {
                  "adapter": { "const": "kani" },
                  "kind": { "const": "bounded-check" },
                  "operation": { "properties": { "type": { "const": "kani" } }, "required": ["type"] }
                },
                "required": ["adapter", "kind", "operation"]
              },
              {
                "properties": {
                  "adapter": { "const": "rust-test" },
                  "kind": { "enum": ["example-test", "property-test", "mutation-witness"] },
                  "operation": { "properties": { "type": { "const": "cargo-test" } }, "required": ["type"] }
                },
                "required": ["adapter", "kind", "operation"]
              },
              {
                "properties": {
                  "adapter": { "const": "python-test" },
                  "kind": { "enum": ["example-test", "property-test"] },
                  "operation": { "properties": { "type": { "const": "pytest" } }, "required": ["type"] }
                },
                "required": ["adapter", "kind", "operation"]
              },
              {
                "properties": {
                  "adapter": { "const": "python-test" },
                  "kind": { "const": "example-test" },
                  "operation": { "properties": { "type": { "const": "generator" } }, "required": ["type"] }
                },
                "required": ["adapter", "kind", "operation"]
              },
              {
                "properties": {
                  "adapter": { "const": "canonical-artifact" },
                  "kind": { "const": "artifact-soundness" },
                  "operation": { "properties": { "type": { "const": "artifact-check" } }, "required": ["type"] }
                },
                "required": ["adapter", "kind", "operation"]
              },
              {
                "properties": {
                  "adapter": { "const": "independent-check" },
                  "kind": { "const": "independent-check" },
                  "operation": { "properties": { "type": { "const": "independent-check" } }, "required": ["type"] }
                },
                "required": ["adapter", "kind", "operation"]
              }
            ]
          },
          {
            "if": { "properties": { "adapter": { "const": "charon-aeneas" } }, "required": ["adapter"] },
            "then": { "properties": { "expected_inventory": { "maxItems": 0 } } },
            "else": {
              "required": ["expected_inventory"],
              "properties": { "expected_inventory": { "minItems": 1 } }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "schema": { "const": "proofbound-evidence-unit/2" } }, "required": ["schema"] },
      "then": {
        "required": ["binding_mode", "transcription", "expected_inventory", "inputs", "outputs", "environment_allowlist"],
        "properties": {
          "adapter": { "const": "trusted-transcription" },
          "kind": { "const": "trusted-transcription" },
          "binding_mode": { "const": "external-round-trip" },
          "operation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": { "type": { "const": "transcription" } }
          },
          "evaluation_mode": false,
          "theorem": false,
          "refinement_theorem": false,
          "bounded_domain": false,
          "premises": { "maxItems": 0 },
          "assumptions": { "maxItems": 0 },
          "outputs": { "maxItems": 0 },
          "environment_allowlist": { "const": ["PATH"] },
          "expected_inventory": { "minItems": 2, "maxItems": 2 },
          "inputs": { "minItems": 3, "maxItems": 3 }
        }
      }
    }
  ],
  "$defs": {
    "exactPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.|\\.git|target|\\.lake|\\.proofbound|\\.venv|__pycache__|\\.pytest_cache|\\.mypy_cache|\\.ruff_cache)(?:/|$))(?!.*[\\\\*?\\[\\]{}])(?!.*//)(?!.*[\\u0000-\\u001f\\u007f-\\uFFFF])[^/]+(?:/[^/]+)*$"
    },
    "formatId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[-_.+][a-z0-9]+)*/[1-9][0-9]*$"
    },
    "trustedTranscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source", "committed_transcription", "driver", "source_format", "transcribed_format", "driver_abi"],
      "properties": {
        "schema": { "const": "proofbound-trusted-transcription/1" },
        "source": { "$ref": "#/$defs/exactPath" },
        "committed_transcription": { "$ref": "#/$defs/exactPath" },
        "driver": { "allOf": [{ "$ref": "#/$defs/exactPath" }, { "pattern": "\\.py$" }] },
        "source_format": { "$ref": "#/$defs/formatId" },
        "transcribed_format": { "$ref": "#/$defs/formatId" },
        "driver_abi": { "const": "proofbound-transcription-driver/1" }
      }
    }
  }
}
