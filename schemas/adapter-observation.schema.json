{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbound.dev/schemas/adapter-observation.schema.json",
  "title": "Proofbound generic adapter execution observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "unit_id", "evidence_kind", "outcome", "input_artifacts", "generated_artifacts", "tool", "adapter", "commands", "runs", "started_unix_ms", "completed_unix_ms", "deterministic_result_sha256", "unit_configuration_sha256", "resource_budget", "resource_usage", "inventory", "normalization"],
  "properties": {
    "schema": { "const": "proofbound-adapter-observation/2" },
    "unit_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "evidence_kind": { "enum": ["theorem", "artifact-soundness", "trusted-transcription", "source-refinement", "bounded-check", "independent-check", "exhaustive-check", "property-test", "example-test", "mutation-witness", "static-check", "review", "assumption", "open"] },
    "outcome": { "enum": ["passed", "failed"] },
    "input_artifacts": { "$ref": "#/$defs/artifacts" },
    "generated_artifacts": { "$ref": "#/$defs/artifacts" },
    "tool": { "$ref": "#/$defs/tool" },
    "adapter": { "$ref": "#/$defs/tool" },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/command" }, "minItems": 1, "maxItems": 4096 },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" }, "minItems": 1, "maxItems": 4096 },
    "started_unix_ms": { "type": "integer", "minimum": 0 },
    "completed_unix_ms": { "type": "integer", "minimum": 0 },
    "deterministic_result_sha256": { "$ref": "#/$defs/digest" },
    "unit_configuration_sha256": { "$ref": "#/$defs/digest" },
    "resource_budget": { "$ref": "#/$defs/budget" },
    "resource_usage": { "$ref": "#/$defs/usage" },
    "inventory": { "type": "array", "items": { "$ref": "#/$defs/inventoryItem" }, "uniqueItems": true, "maxItems": 100000 },
    "normalization": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S" },
    "artifact_binding": { "$ref": "#/$defs/artifact_binding" },
    "trusted_transcription": { "$ref": "#/$defs/trusted_transcription" },
    "mutation_replay": { "$ref": "#/$defs/mutation_replay" },
    "python_plugins": { "type": "array", "items": { "$ref": "#/$defs/python_plugin" }, "uniqueItems": true, "maxItems": 32 },
    "python_property": { "$ref": "#/$defs/python_property" },
    "static_check": { "$ref": "#/$defs/static_check" },
    "distribution_reproduction": { "$ref": "#/$defs/distribution_reproduction" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "passed" } }, "required": ["outcome"] },
      "then": {
        "properties": {
          "inventory": { "minItems": 1 },
          "runs": {
            "items": {
              "properties": {
                    "output_truncated": { "const": false }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["outcome", "evidence_kind"],
        "properties": {
          "outcome": { "const": "passed" },
          "evidence_kind": { "not": { "const": "mutation-witness" } }
        }
      },
      "then": {
        "properties": {
          "runs": { "items": { "properties": { "exit_code": { "const": 0 } } } }
        }
      }
    },
    {
      "if": { "properties": { "evidence_kind": { "const": "trusted-transcription" } }, "required": ["evidence_kind"] },
      "then": { "required": ["trusted_transcription"] },
      "else": { "not": { "required": ["trusted_transcription"] } }
    },
    {
      "if": { "properties": { "evidence_kind": { "const": "mutation-witness" } }, "required": ["evidence_kind"] },
      "then": {
        "required": ["mutation_replay"],
        "properties": {
          "input_artifacts": { "minItems": 4, "maxItems": 4 },
          "generated_artifacts": { "minItems": 1, "maxItems": 1 },
          "inventory": { "minItems": 1, "maxItems": 1 }
        }
      },
      "else": { "not": { "required": ["mutation_replay"] } }
    },
    {
      "if": { "properties": { "evidence_kind": { "const": "static-check" } }, "required": ["evidence_kind"] },
      "then": { "required": ["static_check"] },
      "else": { "not": { "required": ["static_check"] } }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "inventoryItem": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        { "pattern": "\\S" },
        { "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$" }
      ]
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["logical_name", "sha256", "size_bytes"],
      "properties": {
        "logical_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" }, "maxItems": 100000 },
    "tool": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "identity_sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 512 },
        "identity_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value_sha256", "secret"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 256 },
        "value_sha256": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "secret": { "type": "boolean" }
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["program", "args", "environment_allowlist"],
      "properties": {
        "program": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "args": { "type": "array", "items": { "type": "string", "maxLength": 4096 }, "maxItems": 4096 },
        "environment_allowlist": { "type": "array", "items": { "$ref": "#/$defs/environment" }, "maxItems": 256 }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["command_index", "exit_code", "stdout_sha256", "stderr_sha256", "normalized_output_sha256", "output_truncated", "duration_ms"],
      "properties": {
        "command_index": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "exit_code": { "type": ["integer", "null"], "minimum": -2147483648, "maximum": 2147483647 },
        "stdout_sha256": { "$ref": "#/$defs/digest" },
        "stderr_sha256": { "$ref": "#/$defs/digest" },
        "normalized_output_sha256": { "$ref": "#/$defs/digest" },
        "output_truncated": { "type": "boolean" },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["time_ms", "disk_bytes", "memory_bytes"],
      "properties": {
        "time_ms": { "type": "integer", "minimum": 0 },
        "disk_bytes": { "type": "integer", "minimum": 0 },
        "memory_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["time_ms", "peak_disk_bytes", "peak_memory_bytes"],
      "properties": {
        "time_ms": { "type": "integer", "minimum": 0 },
        "peak_disk_bytes": { "type": "integer", "minimum": 0 },
        "peak_memory_bytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "artifact_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_logical_name", "artifact_sha256"],
      "properties": {
        "artifact_logical_name": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "artifact_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "trusted_transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "source", "committed_transcription", "transcribed_candidate", "reencoded_source", "driver", "driver_abi", "source_format", "transcribed_format", "transcriber_role_identity", "reencoder_role_identity"],
      "properties": {
        "schema": { "const": "proofbound-trusted-transcription/1" },
        "source": { "$ref": "#/$defs/artifact" },
        "committed_transcription": { "$ref": "#/$defs/artifact" },
        "transcribed_candidate": { "$ref": "#/$defs/artifact" },
        "reencoded_source": { "$ref": "#/$defs/artifact" },
        "driver": { "$ref": "#/$defs/artifact" },
        "driver_abi": { "const": "proofbound-transcription-driver/1" },
        "source_format": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[-_.+][a-z0-9]+)*/[1-9][0-9]*$" },
        "transcribed_format": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(?:[-_.+][a-z0-9]+)*/[1-9][0-9]*$" },
        "transcriber_role_identity": { "$ref": "#/$defs/digest" },
        "reencoder_role_identity": { "$ref": "#/$defs/digest" }
      }
    },
    "expected_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_index", "allowed_exit_codes"],
      "properties": {
        "run_index": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "allowed_exit_codes": { "oneOf": [{ "const": [1] }, { "const": [101] }] }
      }
    },
    "mutation_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "mutation_id", "registry", "target_preimage", "mutant_artifact", "target_postimage", "witness_source", "check_id", "affected_claims", "baseline_run_index", "expected_failure"],
      "properties": {
        "schema": { "const": "proofbound-mutation-replay-observation/1" },
        "mutation_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,255}$" },
        "registry": { "$ref": "#/$defs/artifact" },
        "target_preimage": { "$ref": "#/$defs/artifact" },
        "mutant_artifact": { "$ref": "#/$defs/artifact" },
        "target_postimage": { "$ref": "#/$defs/artifact" },
        "witness_source": { "$ref": "#/$defs/artifact" },
        "check_id": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "\\S" },
        "affected_claims": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 255 }, "uniqueItems": true, "minItems": 1, "maxItems": 4096 },
        "baseline_run_index": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "expected_failure": { "$ref": "#/$defs/expected_failure" }
      }
    },
    "python_plugin": {
      "type": "object", "additionalProperties": false,
      "required": ["module", "distribution", "version", "origin_sha256"],
      "properties": {
        "module": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*(?:\\.[a-z0-9_]+)*$", "maxLength": 256 },
        "distribution": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "origin_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "python_property": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "framework", "seed", "framework_version"],
      "properties": {
        "schema": { "const": "proofbound-python-property/1" },
        "framework": { "const": "hypothesis" },
        "seed": { "type": "integer", "minimum": 0 },
        "framework_version": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "static_check": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "tool", "tool_version", "configuration_sha256", "targets", "diagnostics"],
      "properties": {
        "schema": { "const": "proofbound-static-check/1" },
        "tool": { "enum": ["mypy", "tsc"] },
        "tool_version": { "type": "string", "minLength": 1, "maxLength": 512 },
        "configuration_sha256": { "$ref": "#/$defs/digest" },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/inventoryItem" }, "uniqueItems": true, "minItems": 1, "maxItems": 4096 },
        "diagnostics": { "const": 0 }
      }
    },
    "distribution_reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "format", "run_digests", "registered_digest", "source_date_epoch", "build_backend_name", "build_backend_version", "member_inventory"],
      "properties": {
        "schema": { "const": "proofbound-distribution-reproduction/1" },
        "format": { "enum": ["wheel", "sdist", "npm-package"] },
        "run_digests": { "type": "array", "items": { "$ref": "#/$defs/digest" }, "minItems": 2, "maxItems": 2 },
        "registered_digest": { "$ref": "#/$defs/digest" },
        "source_date_epoch": { "type": "integer", "minimum": 0 },
        "build_backend_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "build_backend_version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "npm_integrity": { "type": "string", "minLength": 1, "maxLength": 512 },
        "member_inventory": { "type": "array", "items": { "$ref": "#/$defs/inventoryItem" }, "uniqueItems": true, "maxItems": 100000 }
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "const": "npm-package" } }, "required": ["format"] },
          "then": {
            "required": ["npm_integrity"],
            "properties": {
              "source_date_epoch": { "const": 0 },
              "build_backend_name": { "const": "npm" },
              "npm_integrity": { "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
              "member_inventory": { "minItems": 1 }
            }
          },
          "else": { "not": { "required": ["npm_integrity"] } }
        },
        {
          "if": { "properties": { "format": { "const": "wheel" } }, "required": ["format"] },
          "then": { "properties": { "member_inventory": { "minItems": 1 } } }
        }
      ]
    }
  }
}
