{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofbound.dev/schemas/tool-bundle-manifest.schema.json",
  "title": "Proofbound tool bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product_label", "source_revision", "verification_run_id", "platform", "rust_toolchain", "artifacts"],
  "properties": {
    "schema": { "const": "proofbound-tool-bundle-manifest/1" },
    "product_label": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "verification_run_id": { "type": "integer", "minimum": 1 },
    "platform": { "enum": ["linux-x86_64", "linux-aarch64"] },
    "rust_toolchain": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "executable"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,4095}$" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 0, "maximum": 536870912 },
          "executable": { "type": "boolean" }
        }
      }
    }
  }
}
