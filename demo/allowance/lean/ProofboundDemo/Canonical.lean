namespace ProofboundDemo.Canonical

/-! Independent Lean model of `proofbound-allowance-request/1`. -/

def requestMagic : List UInt8 := [0x50, 0x42, 0x41, 0x4c]

def requestVersion : UInt8 := 1

def requestLength : Nat := 38

structure Request where
  fromBalance : Nat
  toBalance : Nat
  amount : Nat
  cap : Nat
  authorized : Bool
  deriving DecidableEq, Repr

private def readU64BE : List UInt8 → Option Nat
  | [a, b, c, d, e, f, g, h] =>
      some <| [a, b, c, d, e, f, g, h].foldl
        (fun value byte => value * 256 + byte.toNat) 0
  | _ => none

private def decodeAuthorization : UInt8 → Option Bool
  | 0 => some false
  | 1 => some true
  | _ => none

def decode : List UInt8 → Option Request
  | m0 :: m1 :: m2 :: m3 :: version :: authorization :: payload =>
      if m0 = 0x50 ∧ m1 = 0x42 ∧ m2 = 0x41 ∧ m3 = 0x4c ∧ version = requestVersion then
        if payload.length = 32 then
          match decodeAuthorization authorization,
              readU64BE (payload.take 8),
              readU64BE ((payload.drop 8).take 8),
              readU64BE ((payload.drop 16).take 8),
              readU64BE (payload.drop 24) with
          | some authorized, some fromBalance, some toBalance, some amount, some cap =>
              some { fromBalance, toBalance, amount, cap, authorized }
          | _, _, _, _, _ => none
        else
          none
      else
        none
  | _ => none

def acceptedFixture : List UInt8 := [
  0x50, 0x42, 0x41, 0x4c, 0x01, 0x01,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x64,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x19,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1e,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x28
]

def acceptedRequest : Request := {
  fromBalance := 100
  toBalance := 25
  amount := 30
  cap := 40
  authorized := true
}

theorem acceptedFixture_decodes :
    decode acceptedFixture = some acceptedRequest := by
  decide

theorem acceptedFixture_has_exact_length :
    acceptedFixture.length = requestLength := by
  decide

theorem acceptedFixture_rejects_trailing_byte :
    decode (acceptedFixture ++ [0]) = none := by
  decide

